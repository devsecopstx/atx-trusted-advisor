{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "npm ci",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest",
        "reevaluateOnRerun": true
      }
    },
    {
      "label": "Build Next (production)",
      "type": "shell",
      "command": "npm run build",
      "group": "build",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest",
        "reevaluateOnRerun": true
      }
    },
    {
      "label": "Build App",
      "type": "shell",
      "command": "npm run build",
      "group": "build",
      "dependsOn": ["Install Dependencies"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest",
        "reevaluateOnRerun": true
      }
    },
    {
      "label": "Free Next dev port (3000)",
      "type": "shell",
      "command": "lsof -ti:3000 | xargs kill -9 2>/dev/null; exit 0",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest",
        "reevaluateOnRerun": true
      }
    },
    {
      "label": "Start Backend (Docker)",
      "type": "shell",
      "command": "npm run dev:backend",
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest",
        "reevaluateOnRerun": true
      }
    },
    {
      "label": "Start Frontend (Next Dev)",
      "type": "shell",
      "command": "npm run dev:frontend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next-dev",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Ready in|Local:\\s+http|started server"
        }
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest",
        "reevaluateOnRerun": true
      }
    },
    {
      "label": "Build and restart dev server",
      "dependsOn": [
        "Build Next (production)",
        "Free Next dev port (3000)",
        "Start Frontend (Next Dev)"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest",
        "reevaluateOnRerun": true
      }
    },
    {
      "label": "Open Localhost",
      "type": "shell",
      "command": "sleep 3 && open http://localhost:3000",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest",
        "reevaluateOnRerun": true
      }
    },
    {
      "label": "Start Local Services",
      "dependsOn": ["Start Backend (Docker)", "Start Frontend (Next Dev)"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest",
        "reevaluateOnRerun": true
      }
    },
    {
      "label": "Run Localhost App (Backend + Frontend)",
      "dependsOn": ["Start Local Services", "Open Localhost"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest",
        "reevaluateOnRerun": true
      }
    }
  ]
}
