# Next.js app (`src/`) — copy to `.env`. Never commit `.env`.
# Server-side Next (API routes, RSC) is not the browser bundle; some features still read env on this process.
# Desk SMTP + “Send test” overrides: canonical template `services/atxfinance-backend/.env.example` — copy those
# keys here too when Next serves `/api/admin/delivery-channels` (see `src/lib/desk-smtp.ts`), not only when Spring sends.
# Seed CLI: `scripts/.env.example`. Compose: `docker-compose.yml` + repo-root `.env`.
# Dotenv / Docker Compose: every non-empty line must be `KEY=value` or a `#` comment — never bare paths.
# Mongo: `MONGODB_URI` may be plain `mongodb://` / `mongodb+srv://` or base64 of either.

# ==========================
# Core secrets (`getEnv()` in src/lib/env.ts)
# ==========================
MONGODB_URI=
XAI_API_KEY=
XAI_MANAGEMENT_API_KEY=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
AUTH_SECRET=
SLACK_WEBHOOK_URL=
ADMIN_SEED_EMAIL=
ADMIN_SEED_X_USER_ID=
ADMIN_SEED_X_USERNAME=
ADMIN_X_USERNAMES=
# Optional absolute origin for password-invite / reset links in email (no trailing slash). Defaults to request URL when unset.
PUBLIC_APP_BASE_URL=http://127.0.0.1:3000
# Optional: overrides PUBLIC_APP_BASE_URL for Capacitor only (`capacitor.config.ts` server.url). Use HTTPS for App Store / TestFlight builds before `npx cap sync ios`.
# CAPACITOR_SERVER_URL=https://atxtrustedadvisory.com
# Optional: access approval sends only /login + forgot-password email (no set-password invite). OAuth-first prod.
# ACCESS_APPROVAL_EMAIL_SIGN_IN_ONLY=true
X_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/api/auth/x/callback
X_OAUTH_AUTHORIZE_URL=
X_OAUTH_TOKEN_URL=
X_OAUTH_USERINFO_URL=
ALLOW_ANY_X_USER_LOGIN=false
# Tenant UX edge enforcement (`src/proxy.ts`) — runbook: `atx-docs/sre-ops/tenant-ux-enforcement.md`; staging-first soak before prod.
# When true (`1`/`true`/`yes`), authenticated HTML/API paths under the proxy matcher resolve tenant route policy at the edge via `GET /api/internal/tenant-ux/policy`.
# Staging soak (PLAN 11): set `TENANT_UX_ENFORCEMENT_V2=true` on Next Cloud Run for 48–72h; keep `TENANT_UX_POLICY_FAIL_CLOSED=false` unless drilling fail-closed.
# TENANT_UX_ENFORCEMENT_V2=false
# When true, non-OK / network failures from that policy route deny requests (`tenant_ux_policy_unavailable`) instead of fail-open. Default off: logs JSON line `type: "tenant_ux_policy_fetch_error"` to stderr.
# TENANT_UX_POLICY_FAIL_CLOSED=false
# Edge session grounding: before protected matcher paths, proxy GETs `/api/internal/authz/session-grounding` (Mongo user + tenant membership). Fail-closed on fetch error. Break-glass disable:
# SESSION_EDGE_GROUNDING=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=
XAI_BASE_URL=
XAI_MANAGEMENT_BASE_URL=
XAI_CHAT_MODEL=grok-4-1-fast-reasoning
XAI_VISION_MODEL=
# Optional if your xAI account has a single team: tenant provisioning infers team_id from the management API list, or creates without team_id (default team). Set explicitly when you have multiple teams or inference fails.
XAI_TEAM_ID=
TENANT_PORTFOLIO_ORG_KEY=
# xChat structured `[xchat/debug]` logs: Admin → Tenant workspace → enable xChat debug (Mongo `tenantPreferences.xchat_debug_enabled`). No env toggle.
XCHAT_USE_REMOTE_HISTORY=false
# Optional: legacy post-loop SSE chunking (simulated deltas after JSON ask). Prefer live token SSE below.
# XCHAT_STREAM_CHUNK_CHARS=256
# XCHAT_STREAM_CHUNK_DELAY_MS=0
# Live token SSE (xAI stream:true inside tool loop). Default **on** when unset; set NEXT_PUBLIC_XCHAT_LIVE_SSE=0|false|no|off to disable.
# NEXT_PUBLIC_XCHAT_LIVE_SSE=true
# XCHAT_LIVE_SSE_ENABLED=true
# Shared secret for Accept: text/event-stream on POST /api/xchat/ask (stream route adds x-xchat-stream-internal).
# XCHAT_STREAM_INTERNAL_SECRET=
# Heartbeat interval for Next SSE ping events (ms).
# XCHAT_SSE_HEARTBEAT_MS=20000
# When ATXFINANCE_BACKEND_ORIGIN is set: forward POST /api/xchat/ask/stream to Spring (stub/JVM). Default off so Next streams real tokens.
# XCHAT_SSE_PROXY_BACKEND=false
ATX_INSTANCE_COLLECTION_ROOT=
XSTRATEGYBUILDER_LICENSING_EMAIL=
XSTRATEGYBUILDER_LICENSING_X_URL=
XSTRATEGYBUILDER_LICENSING_X_LABEL=
XSTRATEGYBUILDER_COMPANY_EMAIL=
NODE_ENV=development
ADMIN_PORTFOLIOS_LIST_ALL=false
XOPTIONS_ASSUME_OPTIONS_APPROVED=false
NEXT_PUBLIC_XOPTIONS_OPTIONS_APPLY_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# ==========================
# Mongo resolution (src/lib/env.ts getMongoUri / DB name)
# ==========================
# MONGODB_URI_B64=
# MONGODB_DB_NAME=
# MONGODB_HOST=localhost
# MONGODB_NO_AUTH=true
# MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=

# ==========================
# Spring BFF proxy (src/lib/backend-bff.ts, auth callbacks)
# ==========================
# ATXFINANCE_BACKEND_ORIGIN=http://127.0.0.1:8080
# NEXT_PUBLIC_ATXFINANCE_BACKEND_ORIGIN=http://127.0.0.1:8080
# AUTH_CALLBACK_USE_SPRING=true

# ==========================
# JVM scheduler → Next (POST /api/internal/scheduler/execute-task)
# ==========================
# Same value as Spring `ATX_SCHEDULER_INTERNAL_SECRET` (min 24 chars). Omit locally if JVM scheduler delegate is off.
# ATX_SCHEDULER_INTERNAL_SECRET=
# Max enabled rows per tenant with ownerKind tenant_user (`/workspace/tasks`). Default 5; optional planOverrides later.
# MAX_TENANT_USER_TASKS=5
# Marketing scheduler publishers (Secret Manager only in stage/prod).
# Preferred: Admin → Marketing → **Connect X for posting** (OAuth) — stores sealed refresh token in Mongo (`xchat_platform_settings`).
# X app redirect URI is the same as user login: `{PUBLIC_ORIGIN}/api/auth/x/callback` (or `X_OAUTH_CALLBACK_URL`). Marketing posting uses tweet.read tweet.write offline.access users.read at connect time.
# Legacy fallback (same refresh-token grant as Connect flow):
# X_OAUTH_REFRESH_TOKEN=
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_ORGANIZATION_URN=urn:li:organization:123456

# ==========================
# Stripe (src/lib/stripe-config.ts, webhooks)
# ==========================
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BASIC_MONTHLY=
# STRIPE_PRICE_PREMIUM_MONTHLY=
# STRIPE_PRICE_PREMIUM_PLUS_MONTHLY=
# STRIPE_PRICE_PREMIUM_PLUS_YEARLY=
# Rental AI — Stripe product/price when billing wires to Checkout (Cloud Run env / GitHub Actions vars; not Secret Manager):
# RENTAL_AI_PRODUCT_ID=prod_...
# RENTAL_BASE_PRICE_ID=price_...
# ENABLE_RENTAL_AI_BILLING=true
# Legacy alias (prefer RENTAL_BASE_PRICE_ID when both exist):
# STRIPE_PRICE_RENTAL_AI_MONTHLY=
# NEXT_PUBLIC_APP_URL=
# APP_BASE_URL=
# VERCEL_URL=   # set by Vercel; optional override for origin resolution

# ==========================
# Public client (`NEXT_PUBLIC_*`)
# ==========================
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SIGNIN_URL=/api/auth/x/login
# Optional: public MCP repo URL for marketing CTAs (defaults to GitHub `xfinance-advisor-mcp` if unset).
# NEXT_PUBLIC_XFINANCE_ADVISOR_MCP_URL=https://github.com/your-org/xfinance-advisor-mcp

# ==========================
# xPersonas / deploy hints (src/modules/xchat/trusted-advisor-xpersonas-collection.ts)
# ==========================
# XPERSONAS_XAI_COLLECTION_DISPLAY_NAME=
# ATX_DEPLOY_TARGET=stage
# DEPLOY_TARGET=

# ==========================
# UI / diagnostics
# ==========================
# APP_USER_SHOW_DB_ENDPOINT=true

# ==========================
# Redis (src/lib/redis-client.ts, workspace snapshot TTL)
# ==========================
# REDIS_URL=
# Optional split planes (preferred for scale): control-plane for rate limits/auth quotas, cache-plane for quote/snapshot caches.
# REDIS_URL_CONTROL=
# REDIS_URL_CACHE=
# REDIS_TLS=false
# REDIS_CONNECT_TIMEOUT_MS=750
# REDIS_QUOTE_CACHE_TTL_SECONDS=30
# REDIS_QUOTE_CACHE_TTL_CLOSED_SECONDS=300
# REDIS_LOGO_CACHE_TTL_SECONDS=604800
# REDIS_WORKSPACE_SNAPSHOT_TTL_SECONDS=60
# Optional: lexical RAG snippet cache (xAI /documents/search). 0 = off (default). 30–3600 when set.
# REDIS_RAG_LEXICAL_CACHE_TTL_SECONDS=300
# Optional: xChat `options_scan` Redis cache TTL (seconds). Default 60, clamped 5–600.
# REDIS_OPTIONS_SCAN_CACHE_TTL_SECONDS=60
# Income ideas (holdings+watchlist wheel/CC JSON prompt path): cache final assistant text; TTL clamped 300–1800 s (default ~20m). Key includes portfolio rev + book/watchlist signatures.
# REDIS_INCOME_IDEAS_RESPONSE_CACHE_TTL_SECONDS=1200
# After successful scanner runs, warm Mongo `portfolio_workspace_snapshots` for the tenant (on by default). Disable: 0|false|no
# PORTFOLIO_SNAPSHOT_WARM_AFTER_SCANNERS=true
# Max portfolios per tenant per warm pass (default 400, max 5000)
# PORTFOLIO_SNAPSHOT_WARM_MAX_PORTFOLIOS=400
# Mongo TTL on `portfolio_workspace_snapshots.materializedAt` (expireAfterSeconds). 0 = no TTL index (Spring purge may still run). Min 60s, max 90d when set.
# PORTFOLIO_WORKSPACE_SNAPSHOT_TTL_SECONDS=604800

# ==========================
# Pub/Sub publishers (src/lib/pubsub/*.ts)
# ==========================
# RECOMMENDATIONS_PUBSUB_TOPIC=
# ALERTS_PUBSUB_TOPIC=
# GOOGLE_CLOUD_PROJECT=
# GCLOUD_PROJECT=
# GCP_PROJECT=

# ==========================
# Desk Slack retries (Next-only — portfolio notifications; src/lib/desk-smtp.ts, portfolio-notification-service)
# ==========================
# DESK_NOTIFICATION_SLACK_RETRIES=2
# DESK_NOTIFICATION_RETRY_BASE_MS=400

