# Copy to `.env` and set each value. Never commit `.env`.
# Mongo: echo -n 'mongodb://... or mongodb+srv://...' | base64

MONGODB_URI_B64=
# Legacy alias also supported:
# MONGODB_URI_B4=

XAI_API_KEY=
XAI_MANAGEMENT_API_KEY=
# XAI_MANAGEMENT_BASE_URL=
# XAI_MANAGEMENT_ROOT_URL=

XAI_TEAM_ID=
ATXFINANCE_COLLECTION_ID=

# X OAuth 2.0 — app credentials (NOT user tokens)
# Use Client ID + Secret from X Developer Portal → Keys and Tokens → OAuth 2.0
# Do NOT store access/refresh tokens here: those are shown once after a test OAuth
# flow and are user-level; the app obtains tokens per-user during the PKCE login flow.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# Session signing; min 16 characters when set
AUTH_SECRET=

X_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/api/auth/x/callback

# Bootstrap admin email for `npm run seed:admin` and OAuth seed path (no default — set explicitly)
ADMIN_SEED_EMAIL=

ADMIN_X_USERNAMES=
ALLOW_ANY_X_USER_LOGIN=false
# When true, logs detailed xChat payloads (RAG, prompts, tools) for expert learning. Set in GCP for staging/prod.
# Configure Cloud Logging retention (e.g. 30 days) at project or log-bucket level.
ENABLE_XCHAT_DEBUG=false
SLACK_WEBHOOK_URL=

# Show Mongo host/db chip in app-user header when NODE_ENV=production (beta stealth on staging builds):
# APP_USER_SHOW_DB_ENDPOINT=true
