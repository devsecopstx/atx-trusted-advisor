# OPTIONS_CHAIN_CACHE_TTL_SEC=900
# PHASE3_WATCHLIST_CHAIN_WARM=false
# PHASE3_CHAIN_WARM_MAX_SYMBOLS=40
# PHASE3_CHAIN_WARM_TARGET_DTE=21
# INVESTMENT_OUTLOOK_REFRESH_ENABLED=false
# INVESTMENT_OUTLOOK_TTL_HOURS=36
