# OPTIONS_SCANNER_GROK_ENABLED=true
# OPTIONS_SCANNER_GROK_MAX_CALLS=12
# OPTIONS_SCANNER_MAX_ALERTS_PER_RUN=5
# OPTIONS_ROLL_MAX_DTE=7
# PRICE_ALERT_COOLDOWN_MS=
