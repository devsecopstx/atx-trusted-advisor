# Copy to `.env` and set each value. Never commit `.env`.
# Dotenv / Docker Compose: every non-empty line must be `KEY=value` or a `#` comment — never bare paths (Compose will error on `/...`).
# Mongo: `MONGODB_URI` may be plain `mongodb://` / `mongodb+srv://` or base64 of either.
# echo -n 'mongodb+srv://...' | base64   # for Secret Manager–friendly values

# ==========================
# App runtime (GCP Secret Manager in stage/prod)
# ==========================
# [GCP_SECRET]
# Leave unset for local Docker Mongo — Next falls back to `mongodb://localhost:27017/<db>` when MONGO_ROOT_PASSWORD is empty; set user+password when your Mongo uses auth.
MONGODB_URI=
XAI_API_KEY=
XAI_MANAGEMENT_API_KEY=
# After a successful `npm run seed:admin`, scripts run `verify-xai-hello` (chat completions + management /collections when keys are set). Skip: SKIP_XAI_POST_SEED_VERIFY=1. Manual only: npm run verify:xai-hello
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
AUTH_SECRET=
SLACK_WEBHOOK_URL=
# Bootstrap global admin email (must match OAuth email from X when X returns email on the profile).
ADMIN_SEED_EMAIL=
# ATX_DEPLOY_TARGET=stage  # optional (RAG / tenant defaults); does NOT change Mongo DB name — use one MONGODB_URI with /your_db in the path for Next + Spring.
# seed:admin uses the same DB as app runtime by default (`MONGODB_DB_NAME` or URI path).
# Optional versioned seed DB: set ADMIN_SEED_DB_VERSION_SUFFIX=on (example: atxfinance-stage-2_4_15)
# Override version token: ADMIN_SEED_APP_VERSION=2.4.15
# ADMIN_SEED_DB_VERSION_SUFFIX=on
# X **numeric** user id (`users/me` → data.id — not @handle). When X omits email, set this and/or `ADMIN_SEED_X_USERNAME` so OAuth matches `ADMIN_SEED_EMAIL` (avoids `email_link_required`). Optional seed-only display hints:
# ADMIN_SEED_X_USER_ID=
# X @handle when userinfo has no email (e.g. if `ADMIN_SEED_X_USER_ID` was wrongly set to the handle — callback accepts handle match too).
# ADMIN_SEED_X_USERNAME=
# ADMIN_SEED_X_DISPLAY_NAME=

# ==========================
# App runtime env vars (GitHub Variables -> gcloud --set-env-vars)
# ==========================
# [GH_VAR]
X_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/api/auth/x/callback
ALLOW_ANY_X_USER_LOGIN=false
# Break-glass: allow global_admin to list/mutate all portfolios in Admin Hub (default: scoped to session user + tenant).
# ADMIN_PORTFOLIOS_LIST_ALL=true
# When true, logs detailed xChat payloads (RAG, prompts, tools) for expert learning.
ENABLE_XCHAT_DEBUG=false
# Deprecated / never wired: ATXFINANCE_COLLECTION_ID — do not set (not in env schema; batch prompts must not reference it).
# xChat turn history: Mongo xchat_logs is source of truth; per-user xAI upload path is disabled in code (see xchat-platform-settings isXchatUserHistoryXaiCollectionEnabled).
# Opt-in legacy (not active until code enables it): sync Mongo xchat_logs to per-user xAI collections — documented only; default remains Mongo + TEAM KB RAG.
# XCHAT_SYNC_TURNS_TO_USER_XAI_COLLECTION=true
# Preferred continuity path: keep xAI conversation state remotely (`store_messages` + `previous_response_id`) and
# stop injecting recent Mongo turns into each ask prompt.
# XCHAT_USE_REMOTE_HISTORY=true
# Dev only: before dev:host / dev:stack, wipe Compose volumes (Mongo), then seed:admin. Prefer npm run dev:host:fresh / dev:stack:fresh instead of setting this in .env.
# DEV_WIPE_LOCAL_MONGO=1

# ==========================
# Stripe billing (Account → /account/billing)
# ==========================
# Stage/prod: NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY, STRIPE_PUBLIC_KEY, STRIPE_SECRET_KEY must exist in
# GCP Secret Manager (ops:secrets:verify:* / Deploy Cloud Run preflight). Sync from this file:
#   npm run ops:secrets:sync-stripe-publishable:staging   # or :prod
# Publishable key: safe in GitHub Environment **Variables** (not Secrets). Next convention:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Local alias (optional): STRIPE_PUBLIC_KEY=pk_test_...
# Secret key: GCP Secret Manager as STRIPE_SECRET_KEY (see deploy workflows); never commit.
# STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret for /api/webhooks/stripe (required in GCP for webhook verification).
# STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring price ids from Stripe Dashboard (GitHub Variables or env):
# STRIPE_PRICE_BASIC_MONTHLY=price_...
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...
# STRIPE_PRICE_PREMIUM_PLUS_MONTHLY=price_...
# Legacy fallback until Stripe Price ids are rotated everywhere (see src/lib/stripe-config.ts):
# STRIPE_PRICE_PREMIUM_PLUS_YEARLY=price_...
# Public origin for Checkout redirects (optional if callbacks are wrong in dev):
# APP_BASE_URL=https://your-host
# NEXT_PUBLIC_APP_URL=https://your-host

# ==========================
# Public URLs (exposed to the browser)
# ==========================
# Pitch Hero primary CTA: defaults to Next.js `/login?next=/xoptions` (login page → X OAuth `/api/auth/x/login`).
# Override only if you need a different entry (direct OAuth, NextAuth, Clerk, etc.):
# NEXT_PUBLIC_SIGNIN_URL=/api/auth/x/login
# NEXT_PUBLIC_SIGNIN_URL=/api/auth/signin
# Pitch waitlist (Formspree — create a form at https://formspree.io, then paste endpoint):
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# ==========================
# Optional app/local settings
# ==========================
# xOptions `/xoptions`: treat all custodian accounts as options-approved unless Account.optionsTradingEnabled is false.
# XOPTIONS_ASSUME_OPTIONS_APPROVED=true
# Optional absolute URL for “Apply here” when an account is not options-approved (custodian application page).
# NEXT_PUBLIC_XOPTIONS_OPTIONS_APPLY_URL=https://example.com/options/apply
# Spring backend (BFF): see atx-docs/sre-ops/api-consolidation-spring-backend.md
#
# ATXFINANCE_BACKEND_ORIGIN — set only when a separate Spring service exists. Value = that JVM service’s HTTPS origin
# (e.g. https://your-backend-xxxxx.run.app). Never the Next app’s public hostname (self-origin → 429 / broken BFF).
# If unset, Next does not BFF-proxy (Mongo handlers for routes that support it).
# When ORIGIN is set: Next proxies admin users, admin portfolios subtree, audit/login-audit/bootstrap/deploy-notes,
# import/broker, rag files, app-user portfolios/positions/recommendations/strategy-jobs, POST /api/access-requests,
# POST /api/user-feedback, and strategy-options — except loopback + NODE_ENV development|test (same Mongo as local auth).
# ATXFINANCE_BACKEND_ORIGIN=http://127.0.0.1:8080
#
# Always Next + Mongo (no BFF): /api/personas*, /api/admin/tasks*, task-runs, scheduler/tick, delivery-channels*.
# NEXT_PUBLIC_ATXFINANCE_BACKEND_ORIGIN=http://127.0.0.1:8080
# AUTH_CALLBACK_USE_SPRING=true  # When set + ATXFINANCE_BACKEND_ORIGIN, proxy OAuth callback to Spring
# JVM strategy job LLM finalizer (after slots_complete → Markdown + fenced JSON v1 on GET …/artifact):
# STRATEGY_FINALIZER_MODEL=grok-4-1-fast-reasoning
# STRATEGY_FINALIZER_SYNC_FOR_GLOBAL_ADMIN=false
# STRATEGY_FINALIZER_MULTI_AGENT_FOR_GLOBAL_ADMIN=true
# STRATEGY_TEAM_KB_COLLECTION_ID=  # optional; else first collection_* from XAI_TEAM_ID resolution
# STRATEGY_FINALIZER_NON_ADMIN_MODEL=grok-4-1-fast-reasoning  # JVM-only fallback when multi-agent path not used
# Stage/prod: one Secret Manager value MONGODB_URI_B64 → Cloud Run env MONGODB_URI for **both** Next and atxfinance-backend (same `/database` in the URI path). Optional override:
# MONGODB_DB_NAME=atxfinance
# When MONGODB_URI is unset, the app builds a local mongodb:// URI. For a non-Docker Mongo with no auth,
# leave MONGO_ROOT_PASSWORD empty and use MONGODB_NO_AUTH=true. For `docker compose` Mongo, `docker-compose.yml`
# defaults init password to `localdev` when MONGO_ROOT_PASSWORD is empty so the root user is always created;
# set MONGO_ROOT_PASSWORD explicitly to override (must match MONGODB_URI credentials).
# MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
# MONGODB_NO_AUTH=true
# Logical org bucket on portfolio docs (`tenantPortfolioOrgKey`); default org-atx-finance for this instance’s client portfolios
# TENANT_PORTFOLIO_ORG_KEY=org-atx-finance
# If set (comma-separated, no @), global_admin OAuth is downgraded unless the signed-in X username is listed. Leave empty for local dev or include every admin handle.
ADMIN_X_USERNAMES=
# Dev hints only (not mounted by default Cloud Run deploy workflow)
# Team UUID (management API) or KB collection id (`collection_*`). Runtime + `npm run seed:admin`: if this is a team UUID, seed resolves the first `collection_*` via management API when XAI_MANAGEMENT_API_KEY is set (tenant_defaults.yaml is not read by seed).
XAI_TEAM_ID=
# Tenant namespace prefix (same string as seed JSON `atxInstanceCollectionRoot`). Drives display names:
#   team KB = `{root}-rag`, xChat history = `{root}-chat-<mongoUserId>`, strategy root files = `{root}-xoption-<env>` (NODE_ENV development|test → dev; else tenant_defaults `app.environment`, default stage).
# RAG tenant collections from seed use `atx-trusted-advisor-<dev|stage|prod>` + segment suffixes (`xpersonas`, `example-prompts`, etc.) — see `atx-rag-collection/README.md`.
# Do NOT set to: xAI collection id (`collection_…`), or `{root}-rag` (seed/runtime strip `-rag` if mistaken).
# Unset = derive `atx-<tier>-<site_slug>` from ATX_DEPLOY_TARGET + site_name (tenant_defaults.yaml).
# Stage/prod: Cloud Run env or GitHub **Variable** — not a Secret.
# ATX_INSTANCE_COLLECTION_ROOT=atx-dev-atx-trusted-advisor
# Optional overrides when root is unset:
# ATX_DEPLOY_TARGET=stage
# ATX_INSTANCE_SITE_SLUG=atx-trusted-advisor
# seed:admin: opt IN to upload repo RAG segments to xAI team collections (same as npm run seed:admin:rag-sync inline)
# SEED_ADMIN_XAI_RAG_INGEST=1
# seed:admin: force OFF xAI RAG upload even if SEED_ADMIN_XAI_RAG_INGEST is set (1/true/yes)
# SKIP_SEED_XAI_RAG_INGEST=1
# seed:admin: skip disk → Mongo xPersona upsert (atx-rag-collection/xpersonas); same flag for npm run seed:xpersonas
# SKIP_SEED_XPERSONAS=1
# seed:admin: skip disk → Mongo options_strategy_preferences (atx-rag-collection/options-strategy); same flag for npm run seed:options-strategy-prefs
# SKIP_SEED_OPTIONS_STRATEGY_PREFS=1
# Skip default admin_scheduled_tasks upsert (Admin → Tasks) after seed:admin — normally leave unset.
# SKIP_SEED_SCHEDULED_TASKS_SYNC=1
# Optional: pre-seed tenant admin delivery channels when running `ops:scheduled-tasks:sync` / post-seed sync.
# Required for slack channel creation when missing in Mongo:
# SCHEDULED_TASKS_SYNC_TRUSTED_ADVISOR_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SCHEDULED_TASKS_SYNC_ATX_ADMIN_CHANNEL_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Scheduled options scanner (`options-strategy-scanner-job` / `options-scanner-engine`): optional caps and Grok usage
# OPTIONS_SCANNER_MAX_POSITIONS=60
# OPTIONS_SCANNER_MAX_WATCHLIST_ROWS=50
# OPTIONS_SCANNER_WATCHLIST_APPEND_MIN_CONFIDENCE=75
# OPTIONS_SCANNER_WATCHLIST_MAX_APPEND_PER_RUN=8
# OPTIONS_SCANNER_GROK_ENABLED=true
# OPTIONS_SCANNER_GROK_MAX_CALLS=12
# OPTIONS_SCANNER_MAX_ALERTS_PER_RUN=5
# Watchlist price scanner — dedupe: skip new portfolio alert if same symbol fired within this window (ms). Default 14400000 (4h). Set 0 to disable cooldown checks.
# PRICE_ALERT_COOLDOWN_MS=
# Portfolio desk Slack webhooks — retry failed posts (extra attempts after first try). Base delay between attempts (ms).
# DESK_NOTIFICATION_SLACK_RETRIES=2
# DESK_NOTIFICATION_RETRY_BASE_MS=400
#
# Portfolio desk email (SMTP) — optional; when all of SMTP_HOST, SMTP_USER, SMTP_PASS, DESK_EMAIL_FROM are set,
# enabled portfolio delivery channels with kind=email receive plain-text desk alerts (price scanner, etc.).
# Recipient addresses are stored per channel in Mongo (`portfolio_delivery_channels.destination`), not in env.
# ZenBusiness / hosted mail: often SMTP_HOST=mail.b.hostedemail.com, SMTP_PORT=587, SMTP_USER=full mailbox address.
# Cloud Run: sync secrets with `npm run ops:secrets:sync-desk-smtp:staging` (or :prod); verify with
# `npm run ops:secrets:verify:staging:with-desk-smtp`. Optional GitHub var `SMTP_SECURE=true` for SMTPS (e.g. port 465).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# DESK_EMAIL_FROM=
# SMTP_SECURE=
# Core scanner audit (`logCoreScannerRunAudit`) — cap stored output / merged JSON / CSV rows (Mongo row weight).
# CORE_SCANNER_AUDIT_OUTPUT_MAX_CHARS=12000
# CORE_SCANNER_AUDIT_DETAILS_JSON_MAX_CHARS=56000
# CORE_SCANNER_AUDIT_ALERT_CSV_MAX_ROWS=500
# CORE_SCANNER option chain cache + Yahoo circuit breaker (scheduled scanners)
# OPTIONS_CHAIN_CACHE_ENABLED=true
# OPTIONS_CHAIN_CACHE_TTL_SEC=900
# SCANNER_CIRCUIT_BREAKER_ENABLED=true
# SCANNER_CIRCUIT_COOLDOWN_SEC=900
# SCANNER_CIRCUIT_FAILURE_THRESHOLD=3
# OPTIONS_ROLL_MAX_DTE=7
# Standalone `npm run seed:xpersonas` / `npm run seed:options-strategy-prefs` use the same DB as Next getDb() (MONGODB_DB_NAME / default).
# seed:admin sets SEED_PARENT_MONGODB_DB_NAME for post-steps; this matches runtime DB by default, or the version-suffixed DB when ADMIN_SEED_DB_VERSION_SUFFIX=on.
# X API endpoint overrides (usually unset)
X_OAUTH_AUTHORIZE_URL=
X_OAUTH_TOKEN_URL=
X_OAUTH_USERINFO_URL=
# Default: https://api.x.ai/v1 (tenant_defaults.yaml / XAI_BASE_URL_DEFAULT in env.ts)
XAI_BASE_URL=
# Default: https://management-api.x.ai/v1 (tenant_defaults.yaml / XAI_MANAGEMENT_BASE_URL_DEFAULT in env.ts)
XAI_MANAGEMENT_BASE_URL=
# Default xAI chat model id (xAI client + Admin → Create xPersona pre-selected model)
XAI_CHAT_MODEL=grok-4-1-fast-reasoning
# Optional: override display name for admin “Sync from xAI → DB” + default xpersonas bucket (else NODE_ENV / ATX_DEPLOY_TARGET)
# XPERSONAS_XAI_COLLECTION_DISPLAY_NAME=atx-trusted-advisor-dev-xpersonas
# App_user header Mongo endpoint chip in prod
# APP_USER_SHOW_DB_ENDPOINT=true

# Optional: Pub/Sub when publishing recommendation events (`src/lib/pubsub/recommendations-publish.ts`).
# Cloud Run: grant the service account `roles/pubsub.publisher` on the topic.
# RECOMMENDATIONS_PUBSUB_TOPIC=recommendations.v1
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional: Redis (PLAN 600) — Next.js only; quote batch cache + /api/health redis field.
# Use redis:// or rediss:// (TLS). If redis-cli uses redis:// but the dashboard shows rediss://,
# set REDIS_TLS=false to force plain TCP, or put redis:// in REDIS_URL (TLS errors are not fixed by TTL).
# [GCP_SECRET] name REDIS_URL when mounting to Cloud Run (see atx-docs/sre-ops/redis-cache-next.md)
# Same REDIS_URL enables Kotlin backend (Memorystore): PKCE, OAuth rate limits, strategy-job quota — atx-docs/sre-ops/spring-redis-memorystore.md
# REDIS_URL=
# REDIS_TLS=false
# Optional Redis connect timeout in milliseconds (clamped 100–10000; default 750).
# REDIS_CONNECT_TIMEOUT_MS=750
# OAUTH_PKCE_REDIS_TTL_SECONDS=600
# AUTH_RATE_LIMIT_LOGIN_PER_MINUTE=30
# AUTH_RATE_LIMIT_CALLBACK_PER_MINUTE=60
# Optional TTL for Yahoo batch quote cache only (seconds, 5–3600; default 30) — unrelated to connection/TLS.
# REDIS_QUOTE_CACHE_TTL_SECONDS=30
# Workspace snapshot JSON for xChat (full preload; Redis or in-process fallback). Clamped 30–900; default 120.
# Hot paths: 30–60 reduces Mongo reads; keys are xf:wsnap:v1:… (tenant, user, portfolioId, workspaceContentRev) — see buildWorkspaceSnapshotCacheKey in src/modules/xchat/workspace-snapshot-cache.ts
# REDIS_WORKSPACE_SNAPSHOT_TTL_SECONDS=60

# Optional overrides: `/xstrategybuilder` licensing line (defaults on main: founder email + X in code — see LICENSING_PITCH_CONTACT_DEFAULTS in src/lib/env.ts)
# XSTRATEGYBUILDER_LICENSING_EMAIL=
# XSTRATEGYBUILDER_LICENSING_X_URL=
# XSTRATEGYBUILDER_LICENSING_X_LABEL=
# XSTRATEGYBUILDER_COMPANY_EMAIL=

# ==========================
# Google Sign-In (optional — enables `/api/auth/google/login` when id + secret are set)
# ==========================
# Console: OAuth 2.0 Client (Web) — authorized redirect URI must match callback URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to {origin}/api/auth/google/callback in dev; set explicitly in staging/prod.
# GOOGLE_OAUTH_CALLBACK_URL=https://your-host/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# ==========================
# GCP project for local gcloud / Secret Manager verify & sync (.env.stage / .env.prod)
# ==========================
# Prefer GOOGLE_PROJECT_ID (matches gcloud and sync-redis / sync-stripe-publishable scripts).
# GOOGLE_PROJECT_ID=fintech-advisor-staging
# GOOGLE_PROJECT_ID=fintech-advisor-prod
# Aliases also accepted by verify-gcp-runtime-secrets.sh: GOOGLE_CLOUD_PROJECT, GCP_PROJECT_ID
#
# Local gcloud deploy (scripts/ops/deploy-cloud-run-from-env.sh) — mirror GitHub vars:
# CLOUD_RUN_REGION=us-central1
# CLOUD_RUN_SERVICE_STAGING=my-staging-service
# CLOUD_RUN_SERVICE_PROD=my-prod-service
# (Use the gcloud service name only — not a https://….run.app URL. Must match the Cloud Run service that owns PROD_BASE_URL / STAGING_BASE_URL domain mappings.)
# STAGING_BASE_URL=https://staging.example.com
# PROD_BASE_URL=https://example.com
# Optional: ALLOW_ANY_X_USER_LOGIN, ENABLE_XCHAT_DEBUG, XAI_CHAT_MODEL, ATXFINANCE_BACKEND_ORIGIN,
# AUTH_CALLBACK_USE_SPRING, STRIPE_PRICE_BASIC_MONTHLY, STRIPE_PRICE_PREMIUM_MONTHLY, STRIPE_PRICE_PREMIUM_PLUS_MONTHLY, STRIPE_PRICE_PREMIUM_PLUS_YEARLY

# ==========================
# IBKR integration (optional — off by default; Phase 2 adds consent + Client Portal session)
# ==========================
# Parsed only by `src/modules/ibkr-integration/config.ts` — not in core `getEnv()` schema.
# IBKR_ENABLED=false
# IBKR_PAPER=true
# IBKR_MAX_REQUESTS_PER_MINUTE=60
# Local Client Portal gateway (https only). Example: https://localhost:5000
# IBKR_CLIENT_PORTAL_BASE_URL=
# Allow POST /api/integrations/ibkr/session (paste Cookie header) in staging — still use HTTPS.
# IBKR_ALLOW_SESSION_COOKIE_BODY=false
# DANGEROUS: one shared CP session for all users (smoke only). Prefer per-user httpOnly cookie from POST session.
# IBKR_USE_ENV_SESSION_COOKIE=false
# IBKR_CLIENT_PORTAL_SESSION_COOKIE=

# ==========================
# Deploy identity / workflow map (do not put runtime app secrets in GH env secrets)
# ==========================
# [GH_ENV_SECRET_OIDC_ONLY]
# GCP_WORKLOAD_IDENTITY_PROVIDER=
# GCP_SERVICE_ACCOUNT_EMAIL=
#
# [GH_VAR]
# GCP_PROJECT_ID_STAGING=
# GCP_PROJECT_ID_PROD=
# CLOUD_RUN_REGION=us-central1
# CLOUD_RUN_SERVICE_STAGING=
# CLOUD_RUN_SERVICE_PROD=
# STAGING_BASE_URL=
# PROD_BASE_URL=
