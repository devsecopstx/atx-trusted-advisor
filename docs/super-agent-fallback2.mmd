---
config:
  theme: neo-dark
  layout: elk
---
flowchart TB
 subgraph subGraph0["Error Paths"]
        ERR1@{ label: "Return error to user:<br>'Unable to load session. Please try again or start new.'<br>Log error + notify admin" }
        ERR2@{ label: "Return fallback:<br>'Strategy generation timed out. Please retry in a moment.'<br>Retry queue or log" }
        ERR3@{ label: "Return:<br>'Failed to parse strategy from AI. Try rephrasing your request.'<br>Log raw output + notify" }
        ERR4@{ label: "Reset to first step + return:<br>'Internal error – restarting questions. What is your outlook?'<br>Log stack trace" }
        ERR5@{ label: "Return question anyway but log:<br>'Failed to save progress – answers may not persist.'" }
        ERR6@{ label: "Return clarifying message:<br>'Sorry, I didn't understand. Please reply with a number (1-3) or the word (e.g. bullish).'<br>Re-ask same question" }
        ERR7@{ label: "Return success message anyway + log:<br>'Answer noted, but progress may not save. Continue.'" }
  end
    A@{ label: "User Message<br>e.g. 'Show my portfolio allocation, build a wheel_root TSLA strategy'" } --> B{"Load or Create Session State<br>USER_XAI_COLL: StrategySession[userId, convId]"}
    B -- Success --> C{"All required inputs collected TEAM_XAI, portfolio_snapshot, watchlist, current_market_sentiment_x_web_search?<br>strategy outlook, risk, horizon, etc."}
    B -- USER_XAI_COLL error / timeout --> ATXERR1
    C -- Yes --> D["Build final prompt from state<br>+ call Grok /api/xchat/ask<br>or /api/xstrategy/generate"]
    D -- Success --> E["Return structured strategy rational_recommendation to USER_XAI_COLL<br>with trades, greeks, P/L, rationale. Add to USER_XAI_COLL"]
    D -- Grok timeout / 5xx --> ATXERR2
    D -- Invalid response / parse fail --> ATXERR3
    C -- No --> F["Determine next missing field<br>based on current step"]
    F -- Logic error / invalid step --> ATXERR4
    F --> G@{ label: "Generate single targeted question<br>with numbered choices<br>e.g. '1. Bullish  2. Neutral  3. Bearish'" }
    G --> H["Send question to user<br>+ update state.step"]
    H -- Update fails --> ATXERR5
    H --> I@{ label: "User replies<br>e.g. '2' or 'neutral outlook'" }
    I --> J["Parse reply<br>keyword match / number / Grok extraction fallback"]
    J -- Parse fails completely --> ATXERR6
    J --> K@{ label: "Save extracted rational_recommendation to USER_XAI_COL" }
    K -- Save fails --> ATXERR6ERR7
    K --> B

    ERR1@{ shape: rect}
    ERR2@{ shape: rect}
    ERR3@{ shape: rect}
    ERR4@{ shape: rect}
    ERR5@{ shape: rect}
    ERR6@{ shape: rect}
    ERR7@{ shape: rect}
    A@{ shape: rect}
    G@{ shape: rect}
    I@{ shape: rect}
    K@{ shape: rect}
     E:::Pine
    classDef Pine stroke-width:1px, stroke-dasharray:none, stroke:#254336, fill:#27654A, color:#FFFFFF
