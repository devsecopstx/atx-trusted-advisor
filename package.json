{
  "name": "atxfinance-app",
  "version": "2.7.3",
  "description": "aTx⚡ Trusted Advisory software and services for finance professionals",
  "scripts": {
    "env:cursor-cloud": "node scripts/update-cursor-cloud-env.mjs",
    "dev": "next dev",
    "dev:frontend": "next dev",
    "dev:backend": "docker compose --env-file .env up",
    "dev:stack": "node scripts/dev/start-dev-stack.mjs",
    "dev:stack:fresh": "DEV_WIPE_LOCAL_MONGO=1 node scripts/dev/start-dev-stack.mjs",
    "dev:host": "node scripts/dev/start-dev-host.mjs",
    "dev:host:fresh": "DEV_WIPE_LOCAL_MONGO=1 node scripts/dev/start-dev-host.mjs",
    "dev:spring": "bash scripts/dev/bootrun-atxfinance-backend.sh",
    "build": "next build",
    "build:backend": "cd services/atxfinance-backend && chmod +x ./gradlew && ./gradlew test --no-daemon",
    "build:stack": "npm run build && npm run build:backend",
    "start": "next start",
    "lint": "eslint .",
    "ci:gate": "npm run lint && npm run typecheck && npm run docs:links && npm run test",
    "docs:links": "node scripts/check-markdown-links.mjs",
    "smoke:verify": "vitest run tests/smoke",
    "smoke:xai-key-create": "vitest run tests/smoke/xai-management-api-key-create-smoke.test.ts",
    "smoke:xai-chat": "bash scripts/ops/xai-chat-completions-smoke.sh",
    "test": "vitest run",
    "test:ci": "mkdir -p test-results && vitest run --reporter=default --reporter=junit --outputFile.junit=test-results/vitest-junit.xml",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "seed:admin": "node --env-file=.env scripts/seed-admin-user.mjs",
    "seed:admin:full": "npm run seed:admin",
    "seed:admin:db": "node --env-file=.env scripts/seed-admin-db.mjs",
    "seed:admin:rag-sync": "node --env-file=.env scripts/seed-admin-rag-sync.mjs",
    "seed:admin:stage": "node --env-file=.env.stage scripts/seed-admin-user.mjs",
    "seed:admin:full:stage": "npm run seed:admin:stage",
    "seed:admin:db:stage": "node --env-file=.env.stage scripts/seed-admin-db.mjs",
    "seed:admin:rag-sync:stage": "node --env-file=.env.stage scripts/seed-admin-rag-sync.mjs",
    "seed:xpersonas": "node --env-file=.env --import tsx scripts/sync-xpersonas-from-yaml.ts",
    "seed:options-strategy-prefs": "node --env-file=.env --import tsx scripts/sync-options-strategy-preferences-from-disk.ts",
    "seed:options-strategy": "node --env-file=.env --import tsx scripts/sync-options-strategy-from-disk.ts",
    "sync:xpersonas:http": "node --env-file=.env --import tsx scripts/sync-xpersonas-from-yaml.ts --api",
    "verify:xai-hello": "node --env-file=.env scripts/verify-xai-hello.mjs",
    "verify:xai-seed-rag": "node --env-file=.env scripts/verify-xai-seed-rag.mjs",
    "mongo:up": "bash scripts/dev/mongo-up.sh",
    "mongo:down": "docker compose --env-file .env stop mongodb",
    "mongo:reset": "bash scripts/dev/mongo-reset-and-seed.sh",
    "local:bootstrap": "npm run mongo:up && npm run seed:admin",
    "one-time-setup": "npm run local:bootstrap",
    "migrate:xchat-identity": "node --env-file=.env scripts/backfill-xchat-identity.mjs",
    "migrate:default-portfolios": "node --env-file=.env scripts/backfill-default-portfolios.mjs",
    "migrate:tenant-portfolio": "node --env-file=.env scripts/migrate-portfolio-portfolios-to-tenant-portfolios.mjs",
    "migrate:persona-name-normalized": "node --env-file=.env scripts/backfill-persona-name-normalized.mjs",
    "migrate:persona-tools": "node --env-file=.env scripts/backfill-persona-tools.mjs",
    "status:deploy": "bash scripts/ops/print-deploy-status.sh",
    "ops:rotate:oauth": "bash scripts/ops/rotate-oauth-secrets.sh",
    "ops:secrets:verify": "bash scripts/ops/verify-gcp-runtime-secrets.sh --project \"${GOOGLE_PROJECT_ID:-${GCP_PROJECT_ID:?set GOOGLE_PROJECT_ID or GCP_PROJECT_ID}}\"",
    "ops:secrets:verify:staging": "bash scripts/ops/verify-gcp-runtime-secrets.sh --project \"${GOOGLE_PROJECT_ID_STAGING:-${GCP_PROJECT_ID_STAGING:-fintech-advisor-staging}}\"",
    "ops:secrets:verify:prod": "bash scripts/ops/verify-gcp-runtime-secrets.sh --project \"${GCP_PROJECT_ID_PROD:-fintech-advisor-prod}\"",
    "ops:secrets:export:prod": "bash scripts/ops/export-gcp-runtime-secrets.sh --project \"${GCP_PROJECT_ID_PROD:-fintech-advisor-prod}\" --output .env.prod.gcp-export",
    "ops:secrets:diff:prod": "bash scripts/ops/diff-local-env-vs-gcp-secrets.sh --project \"${GCP_PROJECT_ID_PROD:-fintech-advisor-prod}\" --env-file .env.prod",
    "ops:secrets:diff:prod:optional": "bash scripts/ops/diff-local-env-vs-gcp-secrets.sh --project \"${GCP_PROJECT_ID_PROD:-fintech-advisor-prod}\" --env-file .env.prod --include-optional",
    "ops:secrets:sync-redis": "bash scripts/ops/sync-redis-url-secret.sh",
    "ops:secrets:sync-redis:staging": "bash scripts/ops/sync-redis-url-secret.sh .env.stage",
    "ops:secrets:sync-redis:prod": "bash scripts/ops/sync-redis-url-secret.sh .env.prod",
    "ops:secrets:sync-stripe-publishable:staging": "bash scripts/ops/sync-stripe-publishable-secrets-from-env.sh .env.stage",
    "ops:secrets:sync-stripe-publishable:prod": "bash scripts/ops/sync-stripe-publishable-secrets-from-env.sh .env.prod",
    "ops:deploy:cloud-run:staging": "bash scripts/ops/deploy-cloud-run-from-env.sh --staging",
    "ops:deploy:cloud-run:staging:ci": "bash scripts/ops/deploy-cloud-run-from-env.sh --staging --with-ci-gate",
    "ops:deploy:cloud-run:production": "bash scripts/ops/deploy-cloud-run-from-env.sh --production",
    "ops:deploy:cloud-run:production:ci": "bash scripts/ops/deploy-cloud-run-from-env.sh --production --with-ci-gate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "type": "module",
  "overrides": {
    "@tootallnate/once": "^3.0.1"
  },
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@google-cloud/pubsub": "^4.11.0",
    "apexcharts": "^5.10.4",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "cronstrue": "^3.14.0",
    "framer-motion": "^12.38.0",
    "mongodb": "^7.1.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-apexcharts": "^2.1.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-rrule-generator": "^1.2.0",
    "react-syntax-highlighter": "^16.1.1",
    "redis": "^4.7.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rrule": "^2.8.1",
    "stripe": "^17.7.0",
    "swagger-ui-dist": "^5.32.1",
    "swagger-ui-react": "^5.32.1",
    "yahoo-finance2": "^3.13.2",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/swagger-ui-react": "^5.18.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  }
}
