{
  "name": "atxfinance-app",
  "version": "3.17.2",
  "description": "aTx⚡ Trusted Advisory software and services for hnwi families and finance professionals",
  "scripts": {
    "env:cursor-cloud": "node scripts/update-cursor-cloud-env.mjs",
    "dev": "next dev",
    "dev:frontend": "next dev",
    "cap:sync:ios": "npx cap sync ios",
    "dev:backend": "docker compose --env-file .env up",
    "dev:stack": "node scripts/dev/start-dev-stack.mjs",
    "dev:stack:fresh": "DEV_WIPE_LOCAL_MONGO=1 node scripts/dev/start-dev-stack.mjs",
    "dev:host": "node scripts/dev/start-dev-host.mjs",
    "dev:host:fresh": "DEV_WIPE_LOCAL_MONGO=1 node scripts/dev/start-dev-host.mjs",
    "dev:spring": "bash scripts/dev/bootrun-atxfinance-backend.sh",
    "build": "next build",
    "build:backend": "cd services/atxfinance-backend && chmod +x ./gradlew && ./gradlew test --no-daemon",
    "build:stack": "npm run build && npm run build:backend",
    "lh:prod": "npx @lhci/cli@latest autorun --config=./.lighthouseci/config.prod-remote.cjs",
    "start": "next start",
    "lint": "eslint .",
    "ci:gate": "npm run lint && npm run typecheck && npm run docs:links && npm run test",
    "docs:links": "node scripts/check-markdown-links.mjs",
    "smoke:verify": "vitest run tests/smoke",
    "smoke:xai-key-create": "vitest run tests/smoke/xai-management-api-key-create-smoke.test.ts",
    "smoke:xai-chat": "bash scripts/ops/xai-chat-completions-smoke.sh",
    "test": "vitest run",
    "test:ci": "mkdir -p test-results && vitest run --reporter=default --reporter=junit --outputFile.junit=test-results/vitest-junit.xml",
    "test:integration": "vitest run tests/integration",
    "test:integration:live": "RUN_INTEGRATION_LIVE=true node scripts/dev/run-live-integration-tests.mjs",
    "test:integration:live:down": "docker compose -p atxfinance-live-tests -f docker-compose.live-tests.yml down -v",
    "typecheck": "tsc --noEmit",
    "seed:admin": "node --env-file=.env scripts/seed-admin-user.mjs",
    "seed:tenant": "node --env-file=.env --import tsx scripts/seed-tenant-from-spec.ts",
    "generate:tenant-spec": "node scripts/generate-tenant-spec.mjs",
    "seed:admin:full": "npm run seed:admin",
    "seed:admin:db": "node --env-file=.env scripts/seed-admin-db.mjs",
    "seed:admin:stage": "node --env-file=.env.stage scripts/seed-admin-user.mjs",
    "seed:admin:full:stage": "npm run seed:admin:stage",
    "seed:admin:db:stage": "node --env-file=.env.stage scripts/seed-admin-db.mjs",
    "seed:xpersonas": "node --env-file=.env --import tsx scripts/sync-xpersonas-from-yaml.ts",
    "seed:options-strategy-prefs": "node --env-file=.env --import tsx scripts/sync-options-strategy-preferences-from-disk.ts",
    "seed:options-strategy": "node --env-file=.env --import tsx scripts/sync-options-strategy-from-disk.ts",
    "sync:xpersonas:http": "node --env-file=.env --import tsx scripts/sync-xpersonas-from-yaml.ts --api",
    "verify:xai-hello": "node --env-file=.env scripts/verify-xai-hello.mjs",
    "verify:xai-seed-rag": "node --env-file=.env scripts/verify-xai-seed-rag.mjs",
    "mongo:up": "bash scripts/dev/mongo-up.sh",
    "mongo:docker-recreate": "bash scripts/dev/mongo-docker-recreate.sh",
    "mongo:down": "docker compose --env-file .env stop mongodb",
    "mongo:reset": "bash scripts/dev/mongo-reset-and-seed.sh",
    "local:bootstrap": "npm run mongo:up && npm run seed:admin",
    "one-time-setup": "npm run local:bootstrap",
    "migrate:xchat-identity": "node --env-file=.env scripts/backfill-xchat-identity.mjs",
    "migrate:default-portfolios": "node --env-file=.env scripts/backfill-default-portfolios.mjs",
    "migrate:tenant-roles": "node --env-file=.env scripts/migrate-tenant-roles.mjs",
    "migrate:tenant-portfolio": "node --env-file=.env scripts/migrate-portfolio-portfolios-to-tenant-portfolios.mjs",
    "migrate:persona-name-normalized": "node --env-file=.env scripts/backfill-persona-name-normalized.mjs",
    "migrate:persona-tools": "node --env-file=.env scripts/backfill-persona-tools.mjs",
    "migrate:merge-user-watchlists": "node --env-file=.env scripts/ops/merge-user-watchlists.mjs",
    "migrate:merge-user-watchlists:apply": "node --env-file=.env scripts/ops/merge-user-watchlists.mjs --apply",
    "status:deploy": "bash scripts/ops/print-deploy-status.sh",
    "ops:rotate:oauth": "bash scripts/ops/rotate-oauth-secrets.sh",
    "ops:secrets:verify": "bash scripts/ops/verify-gcp-runtime-secrets.sh --project \"${GOOGLE_PROJECT_ID:-${GCP_PROJECT_ID:?set GOOGLE_PROJECT_ID or GCP_PROJECT_ID}}\"",
    "ops:secrets:verify:staging": "bash scripts/ops/verify-gcp-runtime-secrets.sh --project \"${GOOGLE_PROJECT_ID_STAGING:-${GCP_PROJECT_ID_STAGING:-fintech-advisor-staging}}\" --with-google-oauth --require-backend-origin",
    "ops:secrets:verify:prod": "bash scripts/ops/verify-gcp-runtime-secrets.sh --project \"${GCP_PROJECT_ID_PROD:-fintech-advisor-prod}\" --require-backend-origin",
    "ops:secrets:verify:prod:with-google-oauth": "bash scripts/ops/verify-gcp-runtime-secrets.sh --project \"${GCP_PROJECT_ID_PROD:-fintech-advisor-prod}\" --with-google-oauth --require-backend-origin",
    "ops:secrets:verify:staging:with-desk-smtp": "bash scripts/ops/verify-gcp-runtime-secrets.sh --project \"${GOOGLE_PROJECT_ID_STAGING:-${GCP_PROJECT_ID_STAGING:-fintech-advisor-staging}}\" --with-google-oauth --with-desk-smtp --require-backend-origin",
    "ops:secrets:verify:prod:with-desk-smtp": "bash scripts/ops/verify-gcp-runtime-secrets.sh --project \"${GCP_PROJECT_ID_PROD:-fintech-advisor-prod}\" --with-desk-smtp --require-backend-origin",
    "ops:secrets:verify:prod:with-scheduler-delegate": "bash scripts/ops/verify-gcp-runtime-secrets.sh --project \"${GCP_PROJECT_ID_PROD:-fintech-advisor-prod}\" --with-scheduler-delegate --require-backend-origin",
    "ops:secrets:export:prod": "bash scripts/ops/export-gcp-runtime-secrets.sh --project \"${GCP_PROJECT_ID_PROD:-fintech-advisor-prod}\" --output .env.prod.gcp-export",
    "ops:secrets:diff:prod": "bash scripts/ops/diff-local-env-vs-gcp-secrets.sh --project \"${GCP_PROJECT_ID_PROD:-fintech-advisor-prod}\" --env-file .env.prod",
    "ops:secrets:diff:prod:optional": "bash scripts/ops/diff-local-env-vs-gcp-secrets.sh --project \"${GCP_PROJECT_ID_PROD:-fintech-advisor-prod}\" --env-file .env.prod --include-optional",
    "ops:secrets:diff:prod:desk-smtp": "bash scripts/ops/diff-local-env-vs-gcp-secrets.sh --project \"${GCP_PROJECT_ID_PROD:-fintech-advisor-prod}\" --env-file .env.prod --include-desk-smtp",
    "ops:secrets:sync-redis": "bash scripts/ops/sync-redis-url-secret.sh",
    "ops:secrets:sync-redis:staging": "bash scripts/ops/sync-redis-url-secret.sh .env.stage",
    "ops:secrets:sync-redis:prod": "bash scripts/ops/sync-redis-url-secret.sh .env.prod",
    "ops:secrets:sync-scheduler-delegate:staging": "bash scripts/ops/sync-scheduler-delegate-secrets-from-env.sh .env.stage",
    "ops:secrets:sync-scheduler-delegate:prod": "bash scripts/ops/sync-scheduler-delegate-secrets-from-env.sh .env.prod",
    "ops:secrets:sync-mongodb:staging": "bash scripts/ops/sync-mongodb-uri-secret-from-env.sh .env.stage",
    "ops:secrets:sync-mongodb:prod": "bash scripts/ops/sync-mongodb-uri-secret-from-env.sh .env.prod",
    "ops:secrets:sync-stripe-publishable:staging": "bash scripts/ops/sync-stripe-publishable-secrets-from-env.sh .env.stage",
    "ops:secrets:sync-stripe-publishable:prod": "bash scripts/ops/sync-stripe-publishable-secrets-from-env.sh .env.prod",
    "ops:secrets:sync-stripe-webhook:staging": "bash scripts/ops/sync-stripe-webhook-secret-from-env.sh .env.stage",
    "ops:secrets:sync-stripe-webhook:prod": "bash scripts/ops/sync-stripe-webhook-secret-from-env.sh .env.prod",
    "ops:secrets:sync-desk-smtp:staging": "bash scripts/ops/sync-desk-smtp-secrets-from-env.sh .env.stage",
    "ops:secrets:sync-desk-smtp:prod": "bash scripts/ops/sync-desk-smtp-secrets-from-env.sh .env.prod",
    "ops:secrets:sync-google-oauth:staging": "bash scripts/ops/sync-google-oauth-secrets-from-env.sh .env.stage",
    "ops:secrets:sync-google-oauth:prod": "bash scripts/ops/sync-google-oauth-secrets-from-env.sh .env.prod",
    "ops:db:probe": "node scripts/ops/probe-mongodb-from-env.mjs",
    "ops:deploy:cloud-run:staging": "bash scripts/ops/deploy-cloud-run-from-env.sh --staging",
    "ops:deploy:cloud-run:staging:ci": "bash scripts/ops/deploy-cloud-run-from-env.sh --staging --with-ci-gate",
    "ops:deploy:full:staging": "bash scripts/ops/deploy-full-stage.sh",
    "ops:deploy:full:staging:ci": "bash scripts/ops/deploy-full-stage.sh --with-ci-gate",
    "ops:deploy:full:production": "bash scripts/ops/deploy-full-production.sh",
    "ops:deploy:full:production:ci": "bash scripts/ops/deploy-full-production.sh --with-ci-gate",
    "ops:deploy:cloud-run:production": "bash scripts/ops/deploy-cloud-run-from-env.sh --production",
    "ops:deploy:cloud-run:production:ci": "bash scripts/ops/deploy-cloud-run-from-env.sh --production --with-ci-gate",
    "ops:deploy:atxfinance-backend:production": "bash scripts/ops/deploy-atxfinance-backend-production.sh",
    "ops:validate:prod-stack-health": "bash scripts/ops/validate-prod-stack-health.sh .env.prod",
    "ops:users:reset-basic-super-agent": "node scripts/ops/reset-all-users-basic-super-agent.mjs",
    "ops:scheduled-tasks:sync": "node --env-file=.env --import tsx scripts/ops/sync-scheduled-tasks-from-spec.ts",
    "ops:rental:mint-key": "node --env-file=.env --import tsx scripts/ops/mint-rental-api-key.ts"
  },
  "keywords": [],
