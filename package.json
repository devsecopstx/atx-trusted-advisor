    "react-syntax-highlighter": "^16.1.1",
    "redis": "^4.7.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rrule": "^2.8.1",
    "stripe": "^17.7.0",
    "swagger-ui-dist": "^5.32.1",
    "swagger-ui-react": "^5.32.1",
