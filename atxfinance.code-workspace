{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      ".next": true,
      "coverage": true
    },
    "search.exclude": {
      ".next": true,
      "coverage": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Install Dependencies",
        "type": "shell",
        "command": "npm ci",
        "problemMatcher": []
      },
      {
        "label": "Build Next (production)",
        "type": "shell",
        "command": "npm run build",
        "problemMatcher": []
      },
      {
        "label": "Build App",
        "type": "shell",
        "command": "npm run build",
        "dependsOn": ["Install Dependencies"],
        "dependsOrder": "sequence",
        "problemMatcher": []
      },
      {
        "label": "Free Next dev port (3000)",
        "type": "shell",
        "command": "lsof -ti:3000 | xargs kill -9 2>/dev/null; exit 0",
        "problemMatcher": []
      },
      {
        "label": "Start Backend (Gradle bootRun, no Docker)",
        "type": "shell",
        "command": "bash scripts/dev/bootrun-atxfinance-backend.sh",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "isBackground": true,
        "problemMatcher": {
          "owner": "spring-boot",
          "pattern": { "regexp": "^$" },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "Started .* in \\d+\\.\\d+ seconds|Started Application"
          }
        }
      },
      {
        "label": "Dev build (host: Gradle bootRun → Next, no backend Docker)",
        "type": "shell",
        "command": "npm run dev:host",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "isBackground": true,
        "problemMatcher": {
          "owner": "next-dev",
          "pattern": { "regexp": "^$" },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "Ready in|Local:\\s+http|started server"
          }
        }
      },
      {
        "label": "Start Frontend (Next Dev)",
        "type": "shell",
        "command": "bash -lc 'set -a; source ${workspaceFolder}/.env 2>/dev/null || true; set +a; npm run dev:frontend'",
        "isBackground": true,
        "problemMatcher": {
          "owner": "next-dev",
          "pattern": { "regexp": "^$" },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "Ready in|Local:\\s+http|started server"
          }
        }
      },
      {
        "label": "Start Backend (Docker)",
        "type": "shell",
        "command": "bash -lc 'docker compose up -d mongodb atxfinance-backend'",
        "problemMatcher": []
      },
      {
        "label": "Build and restart dev server",
        "dependsOn": [
          "Build Next (production)",
          "Free Next dev port (3000)",
          "Start Frontend (Next Dev)"
        ],
        "dependsOrder": "sequence",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": []
      },
      {
        "label": "Open Localhost",
        "type": "shell",
        "command": "sleep 3 && open http://localhost:3000",
        "problemMatcher": []
      },
      {
        "label": "Start Local Services",
        "dependsOn": ["Start Backend (Docker)", "Start Frontend (Next Dev)"],
        "dependsOrder": "sequence",
        "problemMatcher": []
      },
      {
        "label": "Run Localhost App (Backend + Frontend)",
        "dependsOn": ["Start Local Services", "Open Localhost"],
        "dependsOrder": "sequence",
        "problemMatcher": []
      }
    ]
  }
}
