{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      ".next": true,
      "coverage": true
    },
    "search.exclude": {
      ".next": true,
      "coverage": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Install Dependencies",
        "type": "shell",
        "command": "npm ci",
        "problemMatcher": []
      },
      {
        "label": "Build Next (production)",
        "type": "shell",
        "command": "npm run build",
        "problemMatcher": []
      },
      {
        "label": "Build App",
        "type": "shell",
        "command": "npm run build",
        "dependsOn": ["Install Dependencies"],
        "dependsOrder": "sequence",
        "problemMatcher": []
      },
      {
        "label": "Free Next dev port (3000)",
        "type": "shell",
        "command": "lsof -ti:3000 | xargs kill -9 2>/dev/null; exit 0",
        "problemMatcher": []
      },
      {
        "label": "Start Backend (Gradle)",
        "type": "shell",
        "command": "bash -lc '
set -a;
[ -f "${workspaceFolder}/.env" ] && source "${workspaceFolder}/.env";
# Derive Mongo URI from provided variables and expose Spring Boot standard env names
if [ -z "${SPRING_DATA_MONGODB_URI:-}" ]; then
  if [ -n "${MONGODB_URI:-}" ]; then
    export SPRING_DATA_MONGODB_URI="${MONGODB_URI}"
  elif [ -n "${MONGODB_URI_B64:-}" ]; then
    export SPRING_DATA_MONGODB_URI="$(echo "$MONGODB_URI_B64" | base64 -d)"
  fi
fi
# Also set non-Spring alias for compatibility
if [ -z "${MONGODB_URI:-}" ] && [ -n "${SPRING_DATA_MONGODB_URI:-}" ]; then
  export MONGODB_URI="${SPRING_DATA_MONGODB_URI}"
fi
# Provide database name if present (for cases where URI lacks a path)
if [ -z "${SPRING_DATA_MONGODB_DATABASE:-}" ] && [ -n "${MONGODB_DB_NAME:-}" ]; then
  export SPRING_DATA_MONGODB_DATABASE="${MONGODB_DB_NAME}"
fi
set +a;
if [ -x ./gradlew ]; then ./gradlew bootRun; else gradle bootRun; fi'",
        "options": {
          "cwd": "services/atxfinance-backend"
        },
        "isBackground": true,
        "problemMatcher": {
          "owner": "spring-boot",
          "pattern": { "regexp": "^$" },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "Started .* in \\d+\\.\\d+ seconds \\(|Started Application"
          }
        }
      },
      {
        "label": "Start Frontend (Next Dev)",
        "type": "shell",
        "command": "bash -lc 'set -a; source ${workspaceFolder}/.env 2>/dev/null || true; set +a; npm run dev:frontend'",
        "isBackground": true,
        "problemMatcher": {
          "owner": "next-dev",
          "pattern": { "regexp": "^$" },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "Ready in|Local:\\s+http|started server"
          }
        }
      },
      {
        "label": "Start Backend (Docker)",
        "type": "shell",
        "command": "bash -lc 'docker compose up -d mongodb atxfinance-backend'",
        "problemMatcher": []
      },
      {
        "label": "Build and restart dev server",
        "dependsOn": [
          "Build Next (production)",
          "Free Next dev port (3000)",
          "Start Frontend (Next Dev)"
        ],
        "dependsOrder": "sequence",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": []
      },
      {
        "label": "Open Localhost",
        "type": "shell",
        "command": "sleep 3 && open http://localhost:3000",
        "problemMatcher": []
      },
      {
        "label": "Start Local Services",
        "dependsOn": ["Start Backend (Docker)", "Start Frontend (Next Dev)"],
        "dependsOrder": "sequence",
        "problemMatcher": []
      },
      {
        "label": "Run Localhost App (Backend + Frontend)",
        "dependsOn": ["Start Local Services", "Open Localhost"],
        "dependsOrder": "sequence",
        "problemMatcher": []
      }
    ]
  }
}
