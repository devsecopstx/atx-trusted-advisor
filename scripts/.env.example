# Node/CLI scripts (`scripts/*`, `npm run seed:*`, ops) — optional; merge into repo-root `.env` if you use these flags.
# Not read by the Next.js app (`src/`). Next-only keys: repo-root `.env.example`.

# ==========================
# seed:admin / seed scripts
# ==========================
# SKIP_XAI_POST_SEED_VERIFY=1
# SKIP_XAI_POST_SEED_RAG_VERIFY=1
# SKIP_SEED_XPERSONAS=1
# SKIP_SEED_OPTIONS_STRATEGY_PREFS=1
# SKIP_SEED_SCHEDULED_TASKS_SYNC=1
# ADMIN_SEED_DB_VERSION_SUFFIX=on
# ADMIN_SEED_APP_VERSION=2.4.15
# ADMIN_SEED_X_DISPLAY_NAME=
# DEFAULT_TENANT_SLUG=atxfinance-core
# DEFAULT_TENANT_NAME=xFinance Core

# ==========================
# ops:scheduled-tasks:sync (Slack channel bootstrap)
# ==========================
# SCHEDULED_TASKS_SYNC_TRUSTED_ADVISOR_SLACK_WEBHOOK_URL=
# SCHEDULED_TASKS_SYNC_ATX_ADMIN_CHANNEL_SLACK_WEBHOOK_URL=

# ==========================
# Local dev stack (package.json / compose helpers)
# ==========================
# DEV_WIPE_LOCAL_MONGO=1

# ==========================
# verify-xai-hello.mjs (optional model override)
# ==========================
# XAI_VERIFY_MODEL=

# ==========================
# GitHub API (scripts that call GitHub — not Next)
# ==========================
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_TOKEN=

# ==========================
# gcloud / deploy scripts (.env.stage, .env.prod, verify/sync)
# ==========================
# GOOGLE_PROJECT_ID=
# GOOGLE_CLOUD_PROJECT=
# GCP_PROJECT_ID=
# GCP_WORKLOAD_IDENTITY_PROVIDER=
# GCP_SERVICE_ACCOUNT_EMAIL=
# GCP_PROJECT_ID_STAGING=
# GCP_PROJECT_ID_PROD=
# CLOUD_RUN_REGION=us-central1
# CLOUD_RUN_SERVICE_STAGING=
# CLOUD_RUN_SERVICE_PROD=
# STAGING_BASE_URL=
# PROD_BASE_URL=
