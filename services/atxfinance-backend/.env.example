# atxfinance-backend (Kotlin / Spring Boot) — copy to `.env` in this directory. Never commit `.env`.
# Spring Boot does not auto-load dotenv. Prefer repo script (sources repo-root `.env` then this file):
#   npm run dev:spring   → scripts/dev/bootrun-atxfinance-backend.sh
# Manual: `set -a && source .env && set +a && ./gradlew bootRun` from this directory, or put `MONGODB_URI` in the IDE Run Configuration env.
# `MongoUriEnvPostProcessor` is registered via META-INF/spring/org.springframework.boot.env.EnvironmentPostProcessor.imports (Spring Boot 3.2+).
# Docker Compose uses the repo-root `.env` for the `atxfinance-backend` service — copy keys you need from here into that file for full-stack containers.
# Mongo: `MONGODB_URI` may be plain `mongodb://` / `mongodb+srv://` or base64 (`MONGODB_URI_B64`); see `MongoUriEnvPostProcessor`.

# ==========================
# Data stores (shared with Next — same DB name in URI path)
# ==========================
MONGODB_URI=
# MONGODB_URI_B64=
# SPRING_DATA_MONGODB_URI=
MONGODB_DB_NAME=
# SPRING_DATA_MONGODB_DATABASE=

# ==========================
# Redis (PKCE, OAuth rate limits, strategy-job quota — parity with Next)
# ==========================
# REDIS_URL=
# SPRING_DATA_REDIS_URL=
# Next uses REDIS_TLS; JVM may use REDIS_TLS_PLAIN_WITH_REDISS for rediss:// → plain TCP quirks
# REDIS_TLS=
# REDIS_TLS_PLAIN_WITH_REDISS=false
# OAUTH_PKCE_REDIS_TTL_SECONDS=600
# AUTH_RATE_LIMIT_LOGIN_PER_MINUTE=30
# AUTH_RATE_LIMIT_CALLBACK_PER_MINUTE=60
# OAUTH_FLOW_TTL_SECONDS=1800

# ==========================
# xAI (strategy finalizer, RAG upload/search, management API)
# ==========================
XAI_API_KEY=
XAI_MANAGEMENT_API_KEY=
# XAI_BASE_URL=
# XAI_MANAGEMENT_BASE_URL=
# Team UUID or literal collection_* id for strategy TEAM KB resolution
# XAI_TEAM_ID=

# ==========================
# Strategy jobs + LLM finalizer (`application.yml` app.atxfinance.*)
# ==========================
# STRATEGY_FINALIZER_MODEL=grok-4-1-fast-reasoning
# STRATEGY_FINALIZER_SYNC_FOR_GLOBAL_ADMIN=false
# STRATEGY_FINALIZER_MULTI_AGENT_FOR_GLOBAL_ADMIN=true
# STRATEGY_TEAM_KB_COLLECTION_ID=
# STRATEGY_FINALIZER_NON_ADMIN_MODEL=grok-4-1-fast-reasoning
# STRATEGY_JOBS_TTL_DAYS=90
# STRATEGY_MAX_JOBS_HOURLY=12
# STRATEGY_SOFT_WARN_JOBS_HOURLY=8

# ==========================
# Session + X OAuth (cookie signing parity with Next `AUTH_SECRET`)
# ==========================
AUTH_SECRET=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# X_OAUTH_CALLBACK_URL=http://127.0.0.1:8080/api/auth/x/callback
# X_OAUTH_AUTHORIZE_URL=
# X_OAUTH_TOKEN_URL=
# X_OAUTH_USERINFO_URL=
# Secure cookies when set to production
# NODE_ENV=development

# ==========================
# Admin bootstrap / ops
# ==========================
# ADMIN_SEED_EMAIL=

# ==========================
# Desk email + delivery tests (canonical template — Node and JVM use the same var names)
# ==========================
# Next: src/lib/desk-smtp.ts + delivery-channel test route. Spring: DeskSmtpSender + AdminDeliveryChannelsService.
# Mount on whichever service actually sends (often Next Cloud Run today; Spring when BFF owns the route).
# SLACK_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# DESK_EMAIL_FROM=
# SMTP_SECURE=
# Optional Admin “Send test” overrides (both stacks read these):
# DESK_DELIVERY_CHANNEL_TEST_TO=
# DESK_DELIVERY_CHANNEL_TEST_SUBJECT=

# ==========================
# Google Pub/Sub (worker / orchestrator — application.yml app.pubsub)
# ==========================
# PUBSUB_PROJECT_ID=
# PUBSUB_TOPIC=atxfinance-backend-requests
# PUBSUB_DLQ_TOPIC=atxfinance-backend-requests-dlq

# ==========================
# Recommendation events (optional publisher)
# ==========================
# RECOMMENDATIONS_PUBSUB_TOPIC=
# GOOGLE_CLOUD_PROJECT=
# GCLOUD_PROJECT=
# GCP_PROJECT=

# ==========================
# Mongo collection / tenant overrides (defaults in application.yml)
# ==========================
# TENANT_PORTFOLIO_ORG_KEY=org-atx-finance
# TENANT_PORTFOLIO_COLLECTION=tenant_portfolio
# CORE_USERS_COLLECTION=core_users
# RAG_FILES_COLLECTION=xai_collections
# RAG_CHUNKS_COLLECTION=xchat_rag_chunks
# STRATEGY_JOBS_COLLECTION=strategy_jobs

# ==========================
# Admin scheduler (ShedLock + Mongo)
# ==========================
# ADMIN_SCHEDULER_ENABLED=true
# ADMIN_SCHEDULER_POLL_INTERVAL_MS=60000
# ADMIN_SCHEDULER_MAX_TASKS_PER_POLL=50

# ==========================
# Health / diagnostics only (optional)
# ==========================
# DEFAULT_TENANT_SLUG=

# ==========================
# Observability (optional local / Cloud Run)
# ==========================
# OTEL_EXPORTER_OTLP_ENDPOINT=
