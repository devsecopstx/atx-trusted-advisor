#!/usr/bin/env sh
# Optional guardrails for Cursor agent commit prefixes.
# Enable hooks: git config core.hooksPath .githooks
# See .githooks/README.md

set -e

commit_msg_file=${1:-}
if [ -z "$commit_msg_file" ] || [ ! -f "$commit_msg_file" ]; then
  exit 0
fi

first_line=$(head -n1 "$commit_msg_file")

# Do not nag on merges / reverts
case "$first_line" in
  Merge\ *|Revert\ *) exit 0 ;;
esac

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
case "$branch" in
  agent/*|cursor/*|release/*) ;;
  *) exit 0 ;;
esac

# Allowed: cursor-chore / cursor-hotfix, or conventional chore with brand prefix
if printf '%s\n' "$first_line" | grep -qE '^cursor-(chore|hotfix): |^chore: aTx⚡'; then
  exit 0
fi

printf '%s\n' "hint: branch «${branch}» — prefer «cursor-chore: …», «cursor-hotfix: …», or «chore: aTx⚡ …» (see .cursor/skills/test-commit-push/SKILL.md step 11)." >&2

if [ "${XFINANCE_ENFORCE_CURSOR_COMMIT:-}" = "1" ]; then
  printf '%s\n' "error: set XFINANCE_ENFORCE_CURSOR_COMMIT=0 to allow this commit, or fix the subject line." >&2
  exit 1
fi

exit 0
